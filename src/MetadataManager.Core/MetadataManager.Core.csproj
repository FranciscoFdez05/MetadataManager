<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Lógica de la aplicación sin dependencias de Windows Forms: lectura, edición, limpieza,
    exportación y vista previa de metadatos. Usa System.Drawing y el shell de Windows,
    de ahí el destino net10.0-windows.
  -->
  <PropertyGroup>
    <RootNamespace>MetadataManager</RootNamespace>
    <AssemblyName>MetadataManager.Core</AssemblyName>
    <Description>Lectura, edición y borrado de metadatos de archivos.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MetadataManager.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MetadataExtractor" />
    <PackageReference Include="PDFsharp" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <!-- Textos de la capa de servicios: español como idioma neutro y satélite en inglés. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\CoreStrings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)CoreStrings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>MetadataManager.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>CoreStrings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
