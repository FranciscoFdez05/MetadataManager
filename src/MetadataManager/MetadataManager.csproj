<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MetadataManager</RootNamespace>
    <AssemblyName>MetadataManager</AssemblyName>
    <Description>Lectura, edición y borrado de metadatos de archivos.</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Publicación como ejecutable único que no necesita el runtime instalado. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MetadataManager.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MetadataManager.Core\MetadataManager.Core.csproj" />
  </ItemGroup>

  <!-- Las partes de MainForm se agrupan bajo el formulario en el explorador de soluciones. -->
  <ItemGroup>
    <Compile Update="Forms\MainForm.*.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <!-- Textos de la interfaz: Strings.resx es el idioma neutro (español) y Strings.en.resx el satélite inglés. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>MetadataManager.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
