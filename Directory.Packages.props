<Project>

  <!-- Versiones de paquetes centralizadas: los proyectos solo declaran qué paquete usan. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Permite subir de versión dependencias transitivas con fallos de seguridad conocidos. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="MetadataExtractor" Version="2.9.0" />
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Dependencias transitivas fijadas">
    <!-- PDFsharp 6.2.4 arrastra la 8.0.1; GHSA-2fmv-rv2c-59x7 y GHSA-846f-f764-76mx se corrigen en la 10.0.13. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Pruebas">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
